# Production Environment Configuration
# Copy this file to .env.production and update with your production values

# Environment
NODE_ENV=production

# Frontend Configuration (Runtime - can be changed without rebuilding)
# Option 1: Reverse Proxy (Recommended) - nginx proxies /api/* to backend
VITE_API_URL=/api
VITE_ENV=production
VITE_STAGING_MESSAGE=

# Option 2: Separate Subdomain - uncomment and modify if using separate API domain
# VITE_API_URL=https://api.yourdomain.com
# VITE_ENV=production
# VITE_STAGING_MESSAGE=

# Database
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_THIS_IN_PRODUCTION
DB_DATABASE=guide_badges

# Backend
PORT=3000
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_IN_PRODUCTION
CORS_ORIGIN=https://yourdomain.com

# Docker Registry (for production deployment)
REGISTRY_URL=your-registry.com
TAG=latest

# Rate limits per client IP per minute (defaults: 100 overall, 10 for login/password reset)
# THROTTLE_LIMIT=100
# AUTH_THROTTLE_LIMIT=10
