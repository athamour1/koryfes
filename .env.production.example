# Production environment for docker-compose.prod.yml
# Copy to .env.production on the server, fill it in and `chmod 600` it.
# Paste the OUTPUT of the openssl commands, never the `$(...)` text itself.

# Image tag to run (a release from ./release.sh). Pin it so you know what runs
# and can roll back; `latest` is the newest release.
TAG=v1.0.0

# Database — openssl rand -hex 24
# Postgres only reads it when the volume is first created; don't change it later.
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=guide_badges

# Signs login tokens — openssl rand -base64 48
# The backend refuses to start if it is shorter than 32 characters or a placeholder.
# Rotating it logs everyone out.
JWT_SECRET=

# Super admin, created on first boot and its password reset to this on every
# boot. Must be 8+ chars with upper/lowercase letters and a number.
# Leave both empty to skip (the existing admin keeps its current password).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Host address/port the frontend (the only published service) listens on.
# 127.0.0.1 = only a reverse proxy on this host can reach it.
# Proxy in a Docker container: 172.17.0.1. Proxy on another machine: 0.0.0.0
# (and firewall the port to the proxy's IP).
# BIND_ADDR=127.0.0.1
# HTTP_PORT=8080

# Frontend runtime config (no rebuild needed). /api is proxied by the
# frontend's nginx to the backend, so CORS_ORIGIN is not needed.
# VITE_API_URL=/api
# VITE_STAGING_MESSAGE=
# CORS_ORIGIN=https://yourdomain.com

# Rate limits per client IP per minute (defaults: 100 overall, 10 for login/password reset)
# THROTTLE_LIMIT=100
# AUTH_THROTTLE_LIMIT=10
