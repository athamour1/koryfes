{
    "name": "guide-badges-quasar",
    "version": "0.0.1",
    "description": "Track your guide progress and badges",
    "productName": "Korifes",
    "author": "Thanos Mourtzoukos <thanosmour.tk@gmail.com>",
    "type": "module",
    "private": true,
    "scripts": {
        "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
        "dev": "quasar dev",
        "build": "quasar build",
        "postinstall": "quasar prepare",
        "test:e2e": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://127.0.0.1:5173 \"cypress open --e2e\"",
        "test:e2e:ci": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://127.0.0.1:5173 \"cypress run --e2e\"",
        "test:component": "cross-env NODE_ENV=test cypress open --component",
        "test:component:ci": "cross-env NODE_ENV=test cypress run --component"
    },
    "dependencies": {
        "@quasar/extras": "^2.1.0",
        "axios": "^1.13.2",
        "leaflet": "^1.9.4",
        "pinia": "^3.0.4",
        "quasar": "^2.35.0",
        "vue": "^3.5.22",
        "vue-i18n": "^11.2.1",
        "vue-router": "^5.0.6"
    },
    "devDependencies": {
        "@quasar/app-vite": "^3.10.2",
        "@quasar/quasar-app-extension-testing-e2e-cypress": "^7.0.0",
        "autoprefixer": "^10.4.2",
        "cypress": "^15.14.0",
        "eslint-plugin-cypress": "^3.6.0",
        "postcss": "^8.4.14",
        "vite-plugin-vue-devtools": "^8.0.5"
    },
    "engines": {
        "node": "^30 || ^28 || ^26 || ^24 || ^22.22.0",
        "npm": ">= 6.13.4",
        "yarn": ">= 1.21.1"
    }
}
